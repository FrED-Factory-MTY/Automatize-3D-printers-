    "next": "^15.2.3",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "websocket-stream": "^5.5.2",
    "ws": "^8.20.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.13"
